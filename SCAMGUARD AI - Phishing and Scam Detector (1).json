      ],
      "webhookId": "41e461f9-3fd2-4ad7-b143-e358ffb3b059"
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "=<h2>Result: {{ $json.classification }}</h2><p><b>Risk Level:</b> {{ $json.risk_level }}<br><b>Confidence:</b> {{ $json.confidence }}%</p><p><b>Red flags:</b></p><ul>{{ $json.red_flags.length ? $json.red_flags.map(f => \"<li>\" + f + \"</li>\").join(\"\") : \"<li>None found</li>\" }}</ul><p><b>Explanation:</b> {{ $json.explanation }}</p><p><b>Recommended action:</b> {{ $json.recommended_action }}</p>"
      },
