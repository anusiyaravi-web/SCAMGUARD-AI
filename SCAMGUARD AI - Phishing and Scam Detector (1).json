      "id": "59332f81-0d92-4848-8712-2e8e55178aa6",
      "name": "Create Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1024,
        16
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "=<h2 style=\"color:#c0392b\">{{ $json.alert_title }}</h2><p><b>Alert ID:</b> {{ $json.alert_id }}</p><p><b>Classification:</b> {{ $json.classification }}<br><b>Risk Level:</b> {{ $json.risk_level }}<br><b>Confidence:</b> {{ $json.confidence }}%</p><p><b>Red flags:</b></p><ul>{{ $json.red_flags.map(f => \"<li>\" + f + \"</li>\").join(\"\") }}</ul><p><b>Explanation:</b> {{ $json.explanation }}</p><p><b>Recommended action:</b> {{ $json.recommended_action }}</p>"
      },
      "id": "92bd855d-3014-474d-88ba-770ed7f03cee",
      "name": "Show Alert",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
